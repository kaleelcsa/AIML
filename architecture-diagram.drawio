  <diagram id="migration-plan" name="Migration Steps">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="mig-title" value="&lt;b&gt;MIGRATION PLAN — VM to AKS&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#0078D4;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="40" as="geometry"/>
        </mxCell>

        <!-- Phase 1 -->
        <mxCell id="p1" value="&lt;b&gt;PHASE 1&lt;/b&gt;&lt;br&gt;&lt;b&gt;Infrastructure Setup&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Create Resource Group&lt;br&gt;2. Create ACR&lt;br&gt;3. Create AKS Cluster&lt;br&gt;4. Create Azure DB for&lt;br&gt;   PostgreSQL&lt;br&gt;5. Configure networking&lt;br&gt;&lt;br&gt;&lt;i&gt;Est: 1-2 hours&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="230" height="220" as="geometry"/>
        </mxCell>

        <!-- Phase 2 -->
        <mxCell id="p2" value="&lt;b&gt;PHASE 2&lt;/b&gt;&lt;br&gt;&lt;b&gt;Data Migration&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. pg_dump from source VM&lt;br&gt;2. Import to Azure PostgreSQL&lt;br&gt;3. Verify data integrity&lt;br&gt;4. Update connection strings&lt;br&gt;&lt;br&gt;&lt;i&gt;Est: 1-4 hours&lt;br&gt;(depends on data size)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="100" width="230" height="220" as="geometry"/>
        </mxCell>

        <!-- Phase 3 -->
        <mxCell id="p3" value="&lt;b&gt;PHASE 3&lt;/b&gt;&lt;br&gt;&lt;b&gt;Containerization&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Build Apache2 Docker image&lt;br&gt;2. Build Open Liberty image&lt;br&gt;3. Test images locally&lt;br&gt;4. Push images to ACR&lt;br&gt;5. Create K8s manifests&lt;br&gt;&lt;br&gt;&lt;i&gt;Est: 2-4 hours&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="100" width="230" height="220" as="geometry"/>
        </mxCell>

        <!-- Phase 4 -->
        <mxCell id="p4" value="&lt;b&gt;PHASE 4&lt;/b&gt;&lt;br&gt;&lt;b&gt;Deployment &amp; Testing&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Deploy to AKS&lt;br&gt;2. Verify pod health&lt;br&gt;3. Test end-to-end flow&lt;br&gt;4. Configure Ingress + TLS&lt;br&gt;5. Load testing&lt;br&gt;&lt;br&gt;&lt;i&gt;Est: 2-4 hours&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="100" width="230" height="220" as="geometry"/>
        </mxCell>

        <!-- Phase 5 -->
        <mxCell id="p5" value="&lt;b&gt;PHASE 5&lt;/b&gt;&lt;br&gt;&lt;b&gt;Cutover &amp; Go-Live&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. DNS cutover&lt;br&gt;2. Monitor in parallel&lt;br&gt;3. Decommission VMs&lt;br&gt;4. Set up CI/CD pipeline&lt;br&gt;5. Documentation&lt;br&gt;&lt;br&gt;&lt;i&gt;Est: 1-2 hours&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C62828;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="100" width="230" height="220" as="geometry"/>
        </mxCell>

        <!-- Phase arrows -->
        <mxCell id="pa1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#0078D4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="p1" target="p2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pa2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#0078D4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="p2" target="p3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pa3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#0078D4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="p3" target="p4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pa4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#0078D4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="p4" target="p5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Timeline -->
        <mxCell id="timeline" value="&lt;b&gt;Estimated Total Duration: 1-2 Weeks (including testing and parallel running)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#283593;strokeWidth=2;fontSize=13;fontColor=#1A237E;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="370" width="600" height="40" as="geometry"/>
        </mxCell>

        <!-- Risk Section -->
        <mxCell id="risk-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="80" y="450" width="700" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="risk-title" value="&lt;b&gt;Risk Mitigation&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#BF360C;" vertex="1" parent="1">
          <mxGeometry x="100" y="460" width="200" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="• &lt;b&gt;Data Loss&lt;/b&gt; — Full pg_dump backup before migration + verify row counts" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="100" y="490" width="650" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="• &lt;b&gt;Downtime&lt;/b&gt; — Run VMs and AKS in parallel during transition period" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="100" y="515" width="650" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="• &lt;b&gt;Performance&lt;/b&gt; — Load test on AKS before DNS cutover" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="100" y="540" width="650" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="r4" value="• &lt;b&gt;Rollback&lt;/b&gt; — Keep VMs running for 1-2 weeks post-cutover as fallback" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="100" y="565" width="650" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="r5" value="• &lt;b&gt;Security&lt;/b&gt; — NetworkPolicies + SSL + Azure Key Vault from day 1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="100" y="590" width="650" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="r6" value="• &lt;b&gt;Connectivity&lt;/b&gt; — Test AKS-to-PostgreSQL connectivity before data migration" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="100" y="615" width="650" height="22" as="geometry"/>
        </mxCell>

