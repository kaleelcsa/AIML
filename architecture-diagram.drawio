        <mxCell id="pain-title" value="&lt;b&gt;⚠ Challenges with Current Architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#D32F2F;" vertex="1" parent="1">
