        </mxCell>
        <mxCell id="pain1" value="• No auto-scaling — manual VM sizing and provisioning" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="160" y="650" width="400" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="pain2" value="• Manual patching and OS maintenance for each VM" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="160" y="675" width="400" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="pain3" value="• No rolling deployments — downtime during updates" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="160" y="700" width="400" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="pain4" value="• Single point of failure — no built-in HA for DB" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="160" y="725" width="400" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="pain5" value="• Higher cost — VMs run 24/7 regardless of load" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="160" y="750" width="400" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="pain6" value="• Manual backup and disaster recovery for PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
