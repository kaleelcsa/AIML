        <mxCell id="cost-current" value="&lt;b&gt;Current (3 VMs)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Web VM (DS2_v2):  ~$146/mo&lt;br&gt;App VM (DS3_v2):  ~$292/mo&lt;br&gt;DB VM (DS3_v2):   ~$292/mo&lt;br&gt;Managed Disks:    ~$50/mo&lt;br&gt;&lt;b&gt;Total: ~$780/mo&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=1;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="855" y="495" width="280" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="cost-target" value="&lt;b&gt;Target (AKS + Managed DB)&lt;/b&gt;&lt;br&gt;&lt;br&gt;AKS (3 nodes DS2_v2): ~$438/mo&lt;br&gt;Azure PG Flex (D2ds):  ~$196/mo&lt;br&gt;ACR (Standard):        ~$20/mo&lt;br&gt;&lt;b&gt;Total: ~$654/mo&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#2E7D32&quot;&gt;Savings: ~16% + auto-scaling&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1155" y="495" width="290" height="140" as="geometry"/>
        </mxCell>

      </root>
